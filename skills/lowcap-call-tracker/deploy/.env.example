# Lowcap Call Tracker — server environment.
# Copy to /opt/lowcap-tracker/.env on the VPS and fill in. NEVER commit this file.

# Required for the LLM role review (Researcher / Technician / Skeptic / Risk
# Manager on the cheap model, Judge on the stronger one). Without it the tracker
# still runs, on the deterministic heuristic backend.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: FINVIZ Elite key. Present -> CSV export path (fast, complete).
# Absent -> public screener HTML parsing (slower, page-limited).
FINVIZ_API_KEY=

# Push stats.md / improvements.md back to GitHub after each run (1 = yes).
GIT_PUSH=1
# Branch to push to. Leave empty to push the checked-out branch.
GIT_BRANCH=

# Role backend: auto (LLM when the key and the budget allow) | llm | heuristic
ROLE_BACKEND=auto

# --- Telegram (optional) ---------------------------------------------------
# Create a bot with @BotFather, paste the token it gives you here, then message
# your bot and run:  telegram_bot.py --once   (it replies with your chat id),
# or read it from https://api.telegram.org/bot<token>/getUpdates
# Leave TELEGRAM_BOT_TOKEN empty to run the tracker with no Telegram at all.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
