# Lowcap Call Tracker — server environment.
# Copy to /opt/lowcap-tracker/.env on the VPS and fill in. NEVER commit this file.

# REQUIRED. The role review runs on this key (Researcher / Technician / Skeptic /
# Risk Manager on the cheap model, Judge on the stronger one), and the Researcher
# also uses the server-side web_search tool, billed per search.
#
# Without it the run logs BACKEND DOWN, skips the review and records each
# screener hit as UNREVIEWED until a run with a working key judges it. There is
# no offline substitute for the Researcher, Skeptic or Judge, by design.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: FINVIZ Elite key. Present -> CSV export path (fast, complete).
# Absent -> public screener HTML parsing (slower, page-limited).
FINVIZ_API_KEY=

# Push stats.md / improvements.md back to GitHub after each run (1 = yes).
GIT_PUSH=1
# Branch to push to. Leave empty to push the checked-out branch.
GIT_BRANCH=

# Role backend: auto (LLM when the key and the budget allow) | llm | heuristic
# 'heuristic' is for offline testing only — it fakes verdicts that must not
# enter a real record. Leave this on auto in production.
ROLE_BACKEND=auto

# --- Telegram (optional) ---------------------------------------------------
# Create a bot with @BotFather, paste the token it gives you here, then message
# your bot and run:  telegram_bot.py --once   (it replies with your chat id),
# or read it from https://api.telegram.org/bot<token>/getUpdates
# Leave TELEGRAM_BOT_TOKEN empty to run the tracker with no Telegram at all.
#
# TELEGRAM_CHAT_ID takes a NUMERIC id (private chat: 4242; group/supergroup:
# -1001234567890) or @username for a public channel. A private invite link
# (t.me/+hash) is NOT a chat id and is rejected with instructions: a bot cannot
# join from a link, and the hash does not encode the id. Add the bot to the chat,
# post /id@yourbot, then run: telegram_bot.py --list-chats
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
