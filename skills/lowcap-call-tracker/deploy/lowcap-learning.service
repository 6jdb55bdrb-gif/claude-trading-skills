[Unit]
Description=Lowcap call tracker — weekly learning loop (writes improvements.md)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lowcap
Group=lowcap
WorkingDirectory=/opt/lowcap-tracker/repo
Environment=APP_DIR=/opt/lowcap-tracker
ExecStart=/opt/lowcap-tracker/repo/skills/lowcap-call-tracker/deploy/run_learning.sh
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/lowcap-tracker

[Install]
WantedBy=multi-user.target
